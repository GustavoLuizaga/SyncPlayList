
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("user") 
}

model Music{
  music_id   String   @id @default(uuid())
  title      String
  description String
  url        String
  image_url  String
  duration   Int
  artist     String
  addedAt    DateTime @default(now())
  
  @@map("music")
}